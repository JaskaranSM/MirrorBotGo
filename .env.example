# ---- Telegram (required) ----
# Bot token from @BotFather
BOT_TOKEN=
# MTProto app identity from https://my.telegram.org (NOT the bot token)
TG_APP_ID=
TG_APP_HASH=

# ---- Authorization ----
# Owner has full privileges (owner-only commands).
OWNER_ID=0
# Comma-separated extra privileged user ids.
SUDO_USERS=
# Comma-separated chat ids that are pre-authorized (in addition to /addchat).
AUTHORIZED_CHATS=

# ---- Local storage ----
DOWNLOAD_DIR=/app/downloads

# ---- Google Drive ----
# true = use service accounts in SA_DIR; false = OAuth (credentials.json + token.json)
USE_SA=true
SA_DIR=/app/accounts
GDRIVE_CREDENTIALS_FILE=/app/credentials.json
GDRIVE_TOKEN_FILE=/app/token.json
# Default destination Drive folder id (and a Shared Drive id works too).
GDRIVE_PARENT_ID=
IS_TEAM_DRIVE=true
# Optional base URL used to build "Shareable Link" entries.
INDEX_URL=
# Parallel per-file transfers.
GDRIVE_CONCURRENCY=10

# ---- Database (sqlite or postgres) ----
DB_DRIVER=sqlite
DB_DSN=file:/app/data/mirrorbot.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# For postgres:
# DB_DRIVER=postgres
# DB_DSN=postgres://mirrorbot:mirrorbot@db:5432/mirrorbot?sslmode=disable

# ---- Status display / UX ----
STATUS_UPDATE_INTERVAL=5
STATUS_MESSAGES_PER_PAGE=5
AUTO_DELETE_TIMEOUT=0
STATUS_MESSAGE_AUTO_DELETE_TIME=0
SPAM_FILTER_MESSAGES=1
SPAM_FILTER_DURATION=10

# ---- Torrent engine ----
TORRENT_LISTEN_PORT=42069
TORRENT_PEER_ID_PREFIX=-qB5000-
TORRENT_MAX_UPLOAD_RATE=100KiB
TORRENT_ESTABLISHED_CONNS_PER_TORRENT=100
TORRENT_SEED=false
TORRENT_USE_TRACKER_LIST=false
TORRENT_TRACKER_LIST_URL=https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_best.txt

# ---- Health ----
HEALTH_ADDR=:7870
